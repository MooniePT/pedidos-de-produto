MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=pedidos_produto
PORT=3001
# Palavra-passe das contas que já vêm na base de dados (só é usada quando a conta ainda não tem uma).
PALAVRA_PASSE_INICIAL=pedidos123
# Em produção, com HTTPS: o cookie da sessão só é enviado por ligações seguras.
COOKIE_SEGURO=false
